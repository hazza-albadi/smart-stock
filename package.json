{
  "name": "smartstock-live",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/check-env.mjs --pre && next dev",
    "build": "next build",
    "start": "next start",
    "seed": "tsx scripts/seed.ts",
    "audit": "tsx scripts/audit.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsx scripts/check.ts",
    "literals": "tsx scripts/literals.ts",
    "baseline": "tsx scripts/baseline.ts",
    "locales": "python scripts/locales_messages.py && python scripts/locales_ui.py && python scripts/locales_wording.py && python scripts/locales_space.py && python scripts/locales_budget.py && python scripts/locales_offers.py && python scripts/locales_agents.py && python scripts/locales_site.py && python scripts/locales_review.py",
    "docs:agents": "tsx scripts/docs-agents.ts",
    "doctor": "node scripts/check-env.mjs",
    "req:update": "node scripts/make-req.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
