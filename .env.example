# Copy this file to .env.local and fill in what you need. Everything here is OPTIONAL: the app works fully without it.
# Never commit .env.local (it is git-ignored) and never put real keys in this example file.

# Lets a model polish the wording of supplier messages when you press "Run analysis". Numbers stay deterministic.
ANTHROPIC_API_KEY=
# Model used for that wording (leave empty for the default).
SMARTSTOCK_MODEL=
# Use another database file instead of ./smartstock.db (leave empty for the default).
SMARTSTOCK_DB=
# Port of `npm run dev` (leave empty for 3000).
PORT=
