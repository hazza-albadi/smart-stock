# better-sqlite3 13 ships prebuilt binaries for Windows, macOS and Linux inside the package.
# Without this line npm 11 still runs `node-gyp rebuild` on install, which needs Visual Studio / Xcode tools / build-essential.
# Nothing else in this project needs an install script. To compile from source on purpose: npm rebuild better-sqlite3 --ignore-scripts=false --build-from-source
ignore-scripts=true
